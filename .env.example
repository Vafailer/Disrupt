# Пример настроек. Python не загружает этот файл сам.
# Настоящий .env и ключи не добавляйте в Git. Демо всегда работает в режиме mock.
NOTES_DATABASE_URL=sqlite:///./data/notes.db
NOTES_PROVIDER=mock
NOTES_AUTO_WORKER=true
NOTES_PUBLIC_ORIGIN=http://127.0.0.1:8000
NOTES_SECURE_COOKIES=false
NOTES_ALLOW_REGISTRATION=true
NOTES_ALLOW_LIVE_REQUESTS=false
NOTES_CLOUDRU_MODEL=
NOTES_CLOUDRU_BASE_URL=https://shared1.multitool.works:4000/v1
NOTES_CLOUDRU_API_KEY=
NOTES_LIVE_CALL_LIMIT=0
NOTES_LIVE_USER_CALL_LIMIT=0
NOTES_ERROR_LOG_FILE=data/errors.log
# Service API for a separate Telegram adapter. Disabled when unset.
# Prefer NOTES_INTERNAL_API_TOKEN_FILE in deployment; never reuse the model key.
NOTES_INTERNAL_API_TOKEN_FILE=
