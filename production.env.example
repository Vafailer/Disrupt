# На сервере скопируйте в .env.production. Этот файл с реальными значениями не добавляйте в Git.
APP_DOMAIN=notes.example.ru
NOTES_CLOUDRU_MODEL=deepseek-v4-flash
NOTES_CLOUDRU_BASE_URL=https://shared1.multitool.works:4000/v1
NOTES_LIVE_CALL_LIMIT=100
NOTES_LIVE_USER_CALL_LIMIT=10
# Дневной лимит ИИ на человека в единицах. 0 отключает дневную проверку. Подробности в docs/ai-daily-limit-v1.md.
NOTES_DAILY_UNIT_LIMIT=30
NOTES_TEXT_UNIT_COST=1
NOTES_AUDIO_UNIT_BASE=2
NOTES_AUDIO_UNIT_PER_MINUTE=1
NOTES_LIMIT_TIMEZONE=Europe/Moscow
NOTES_ALLOW_REGISTRATION=true
# Админка открывается только из приватной сети. Подробности в docs/admin-security-v1.md.
# Если админку открывают по обычному HTTP (WireGuard или SSH-туннель), поставьте false.
NOTES_ADMIN_COOKIE_SECURE=true
# Список сетей через запятую. Значение по умолчанию подходит для WireGuard 10.77.0.0/24 и localhost.
# NOTES_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,10.77.0.0/24
NOTES_STT_ENABLED=false
NOTES_STT_PROTOCOL_CONFIRMED=false
NOTES_STT_MODEL=whisper-large-v3
NOTES_TELEGRAM_BOT_USERNAME=beresta_ru_bot
# Почта выключена. Чтобы включить, заполните SMTP и смонтируйте файл с паролем. См. docs/auth-telegram-v1.md.
NOTES_MAIL_ENABLED=false
NOTES_SMTP_HOST=
NOTES_SMTP_PORT=587
NOTES_SMTP_USER=
NOTES_SMTP_PASSWORD_FILE=
NOTES_MAIL_FROM=
# Шифрование данных включено в compose. Файл ключа создайте один раз и не перезаписывайте:
# umask 077; openssl rand -base64 32 > secrets/data_key.txt
# Подробности и порядок включения в docs/encryption-v1.md. Ключ храните отдельно от бэкапов базы.
# При смене ключа укажите здесь пути старых ключей через запятую, например /run/secrets/data_key_old_1.
NOTES_DATA_OLD_KEY_FILES=
